<Page x:Class="MuhenKit.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B0E10">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="#141719" BorderBrush="#2A2F33" BorderThickness="0,0,0,1" Padding="8,6,16,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Click="OnHome" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Ana sayfa" VerticalAlignment="Center" IsTabStop="False">
                <FontIcon Glyph="&#xE80F;" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Projelerim" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" Foreground="#9FB6DC" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="Search" PlaceholderText="Proje ara…" Width="220" TextChanged="OnSearch"/>
                <Button Click="OnOpenDxf">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14"/><TextBlock Text="DXF aç"/></StackPanel>
                </Button>
                <Button Click="OnNew" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Yeni proje"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="20,16,20,20">
            <VariableSizedWrapGrid x:Name="Cards" Orientation="Horizontal" ItemWidth="300" ItemHeight="252"/>
        </ScrollViewer>
        <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="#F2B266"/>
            <TextBlock x:Name="EmptyText" Text="Henüz proje yok. Bir DXF açın ya da boş proje başlatın — düzenlemeleriniz burada otomatik saklanır."
                       TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" Foreground="#9FB6DC"/>
        </StackPanel>
    </Grid>
</Page>
